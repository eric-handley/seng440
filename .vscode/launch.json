{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug compression",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/out",
            "args": ["-c", "-i", "samples/sample_1.wav", "-o", "build/compressed.wav"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Arm",
                    "text": "-gdb-set disassembly-flavor arm",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Run `make build-debug`"
        },
        {
            "name": "(gdb) Debug decompression",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/out",
            "args": ["-d", "-i", "build/compressed.wav", "-o", "build/decompressed.wav"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Arm",
                    "text": "-gdb-set disassembly-flavor arm",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Run `make build-debug`"
        }

    ]
}